CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Session issuer is derived from a valid publishable key unless explicitly set.
CLERK_ISSUER=
# Exact frontend origins; falls back to ALLOWED_ORIGINS. Required in production.
CLERK_AUTHORIZED_PARTIES=
# Set only if the deployed Clerk JWT template includes an audience claim.
CLERK_AUDIENCE=
DATABASE_URL=postgres://user:password@localhost/hafapass_api_production

# Production defaults to the bounded general-admission pilot. "full" exposes
# advanced features but does not bypass provider, event, or release approvals.
HAFAPASS_LAUNCH_SCOPE=general_admission
# Full deployed commit SHA; use COMMIT_REF only when GIT_SHA is unavailable.
GIT_SHA=
COMMIT_REF=

# Stripe sandbox. Production live keys are separate and remain disabled until
# an independent, current platform-capability evidence review is approved.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_TEST_SECRET_KEY=sk_test_xxx
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Increment this non-secret revision whenever provider-side configuration
# changes (domains, webhook subscriptions, issuer/class state, or accounts).
# Secret rotations are also detected automatically by a non-reversible digest.
PROVIDER_CONFIGURATION_REVISION=local-development-1

# Optional card-present pilot. Still requires per-organization token/account
# verification and independent BOH/Clover capability approval.
CLOVER_REST_PAY_BASE_URL=

# AWS S3 (optional: presign endpoint returns 503 without these).
# Configure expiry of pending/ objects with a bucket lifecycle rule. Completion
# verifies bytes then copies to uploads/; the backend needs Head/Get/Copy access.
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_BUCKET=hafapass-uploads
AWS_REGION=us-west-2

# Resend. Development simulates delivery until evidence is approved; production
# fails closed instead of recording a simulated customer message.
RESEND_API_KEY=re_xxx
RESEND_WEBHOOK_SECRET=
MAILER_FROM_EMAIL=tickets@hafapass.com
# Wallet pass signing (production provider credentials; never commit real values)
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERTIFICATE_BASE64=
APPLE_PASS_CERTIFICATE_PASSWORD=
APPLE_WWDR_CERTIFICATE_BASE64=
APPLE_PASS_ICON_PATH=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
# Switch to APPROVED only after Google approves the event-ticket class.
GOOGLE_WALLET_CLASS_REVIEW_STATUS=UNDER_REVIEW
