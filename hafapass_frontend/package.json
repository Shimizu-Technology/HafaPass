{
  "name": "hafapass_frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "translate": "gt translate",
    "translate:safe": "node scripts/translate-safe.mjs",
    "build": "npm run translate:safe && vite build",
    "build:no-translate": "vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high || (sleep 30 && npm audit --omit=dev --audit-level=high) || (sleep 90 && npm audit --omit=dev --audit-level=high)"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@sentry/react": "^11.11.0",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "@zxing/browser": "^0.2.1",
    "axios": "^1.21.0",
    "framer-motion": "^14.9.1",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.70.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sentry/vite-plugin": "^11.11.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "gt": "2.27.1",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-navigation-preload": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "overrides": {
    "form-data": "^4.0.6"
  }
}
